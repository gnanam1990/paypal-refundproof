{
  "name": "paypal-refundproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "secret-scan": "node scripts/secret-scan.mjs",
    "identity:vectors": "tsx scripts/identity-vectors.ts",
    "pack:check": "node docs/build-pack/scripts/check-build-pack.mjs --root docs/build-pack",
    "verify:m00": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm secret-scan && pnpm pack:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
