# Copy to .env.local (or run `pnpm setup:env`). Never commit real values.
DATABASE_URL=postgres://localhost:5432/refundproof
# 32 random bytes, base64. Encrypts customer evidence at rest.
REFUNDPROOF_DATA_KEY=
APP_ORIGIN=http://localhost:3000
# Proposal model: none (proposals written by hand) | anthropic | ollama | local-fixture (dev only).
# The Anthropic SDK resolves its own credential from the server environment; never put it in this file.
REFUNDPROOF_MODEL_PROVIDER=none
REFUNDPROOF_MODEL=claude-opus-5-5
REFUNDPROOF_MODEL_EFFORT=high
# Ollama is restricted to an unauthenticated loopback URL. Example model: qwen3:4b.
REFUNDPROOF_OLLAMA_ORIGIN=http://127.0.0.1:11434
# Capture lookups: none | contract-stub (labelled fixtures, dev only) | paypal-sandbox (M04).
REFUNDPROOF_CAPTURE_SOURCE=none
# PayPal REST sandbox (server-only; never commit values). Unset = BLOCKED_CREDENTIAL. Live PayPal is refused.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
REFUNDPROOF_RECONCILE_DEADLINE_MS=86400000
